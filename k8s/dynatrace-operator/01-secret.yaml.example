apiVersion: v1
kind: Secret
metadata:
  name: eks-k8s-2026-06-10
  namespace: dynatrace
  labels:
    dynatrace.com/created-by: "dynatrace.kubernetes"
type: Opaque
stringData:
  # API token — required scopes:
  #   entities.read, settings.read, settings.write,
  #   activeGateTokenManagement.create, credentialVault.read,
  #   metrics.ingest, bizevents.ingest, logs.ingest, DataExport
  apiToken: "REPLACE_WITH_DT_API_TOKEN"

  # PaaS / data-ingest token — used to download OneAgent code modules
  dataIngestToken: "REPLACE_WITH_DT_PAAS_TOKEN"
